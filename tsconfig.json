{
  "compilerOptions": {
    "declaration": true,
    "importHelpers": true,
    "skipLibCheck": true,
    "module": "nodenext",
    "outDir": "lib",
    "rootDir": "src",
    "strict": true,
    "target": "es2024",
    "lib": ["es2024", "dom"],
    "sourceMap": true,
    "moduleResolution": "nodenext",
    "allowSyntheticDefaultImports": true,
  },
  "include": [
    "src/**/*"
  ]
}
