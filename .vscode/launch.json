{
    "version": "0.2.0",
    "configurations": [
      {
        "type": "node",
        "request": "launch",
        "name": "Debug APIMatic CLI",
        "skipFiles": ["<node_internals>/"],
        "program": "${workspaceFolder}/bin/run.js",
        "args": [],
        "console": "externalTerminal",
        "preLaunchTask": "npm: build"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug CLI Tests",
      "program": "${workspaceFolder}/node_modules/tsx/dist/cli.mjs",
      "args": [
        "${workspaceFolder}/node_modules/mocha/bin/_mocha",
        "--forbid-only",
        "test/**/*.test.ts",
        // "--ignore",
        // "test/commands/portal/generate.test.ts",
        // "${file}", // Run Tests for the currently open test file.
        "--timeout",
        "99999"
      ],
      "cwd": "${workspaceFolder}",
      "runtimeArgs": [
        "--nolazy",
        "--inspect-brk",
        "--trace-warnings"
      ],
      "internalConsoleOptions": "openOnSessionStart",
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    }
  ]
}