{
    "name": "@apimatic/cli",
    "description": "The official CLI for APIMatic.",
    "version": "1.3.1",
    "author": "APIMatic",
    "bin": {
        "apimatic": "./bin/run.js"
    },
    "bugs": {
        "url": "https://github.com/apimatic/apimatic-cli/issues",
        "email": "support@apimatic.io"
    },
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "packageManager": "pnpm@11.0.8",
    "files": [
        "./bin",
        "./lib",
        "./portal-template",
        "./portal-pages",
        "/oclif.manifest.json",
        "/apimatic.schema.json"
    ],
    "repository": "git://github.com/apimatic/apimatic-cli.git",
    "homepage": "https://docs.apimatic.io/apimatic-cli/intro-and-install/",
    "keywords": [
        "apimatic",
        "cli",
        "sdk generation",
        "openapi",
        "api",
        "automation"
    ],
    "license": "MIT",
    "type": "module",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "scripts": {
        "build": "rimraf lib tsconfig.tsbuildinfo oclif.manifest.json && tsc",
        "build:watch": "rimraf oclif.manifest.json && tsc --watch",
        "apimatic": "node ./bin/run.js",
        "prepack": "oclif manifest",
        "pretest": "tsc -p test/tsconfig.json",
        "posttest": "eslint .",
        "prettier": "prettier \"src/**/*.{js,ts}\" \"portal-template/**/*.{ts,tsx}\"",
        "format": "prettier --write \"src/**/*.{js,ts}\" \"portal-template/**/*.{ts,tsx}\"",
        "lint": "eslint \"src/**/*.{js,ts}\"",
        "lint:fix": "eslint --fix \"src/**/*.{js,ts}\" --quiet",
        "readme": "oclif readme",
        "test": "tsx node_modules/mocha/bin/_mocha --forbid-only \"test/**/*.test.ts\" --timeout 99999"
    },
    "dependencies": {
        "@apimatic/sdk": "0.2.0-alpha.10",
        "@clack/core": "1.0.0-alpha.1",
        "@clack/prompts": "1.0.0-alpha.1",
        "@fumadocs/api-docs": "0.2.8",
        "@oclif/core": "^4.2.8",
        "@oclif/plugin-autocomplete": "^3.2.24",
        "@oclif/plugin-help": "^6.2.26",
        "@scalar/json-magic": "0.13.4",
        "@tailwindcss/vite": "4.3.3",
        "@tanstack/react-router": "1.170.33",
        "@tanstack/react-start": "1.168.50",
        "@tanstack/start-static-server-functions": "1.167.33",
        "@vitejs/plugin-react": "6.1.1",
        "adm-zip": "^0.5.17",
        "ansis": "^3.17.0",
        "async-mutex": "^0.5.0",
        "axios": "^1.8.1",
        "execa": "^9.6.0",
        "fast-levenshtein": "^3.0.0",
        "form-data": "^4.0.2",
        "fs-extra": "^11.3.0",
        "fumadocs-core": "16.15.8",
        "fumadocs-mdx": "15.4.0",
        "fumadocs-openapi": "11.4.1",
        "fumadocs-ui": "16.15.8",
        "get-port": "^7.1.0",
        "is-in-ci": "^2.0.0",
        "isomorphic-git": "^1.37.2",
        "lucide-react": "1.43.0",
        "mustache": "^4.2.0",
        "neverthrow": "^8.2.0",
        "open": "^8.4.0",
        "picocolors": "^1.1.1",
        "prettier": "^2.8.8",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "semver": "^7.8.0",
        "shiki": "4.4.3",
        "striptags": "^3.2.0",
        "tailwindcss": "4.3.3",
        "tmp-promise": "^3.0.3",
        "tslib": "^2.8.1",
        "uuid": "^11.1.0",
        "vite": "8.2.2",
        "yaml": "^2.8.0",
        "yazl": "^3.3.1"
    },
    "devDependencies": {
        "@commitlint/cli": "^20.5.0",
        "@commitlint/config-conventional": "^20.5.3",
        "@eslint/js": "^9.34.0",
        "@oclif/test": "^4.1.13",
        "@semantic-release/changelog": "^6.0.3",
        "@semantic-release/git": "^10.0.1",
        "@types/adm-zip": "^0.5.8",
        "@types/base-64": "^1.0.0",
        "@types/chai": "^4.3.20",
        "@types/fast-levenshtein": "^0.0.4",
        "@types/fs-extra": "^9.0.13",
        "@types/mocha": "^10.0.10",
        "@types/mustache": "^4.2.6",
        "@types/node": "^24.13.4",
        "@types/prettier": "^2.7.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/semver": "^7.8.0",
        "@types/sinon": "^17.0.4",
        "@types/treeify": "^1.0.3",
        "@types/unzipper": "^0.10.4",
        "@types/yazl": "^3.3.0",
        "@typescript-eslint/eslint-plugin": "^8.0.0",
        "@typescript-eslint/parser": "^8.0.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "ajv": "^8.20.0",
        "chai": "^4.5.0",
        "eslint": "^9.21.0",
        "eslint-config-prettier": "^8.3.0",
        "eslint-plugin-import": "^2.25.2",
        "husky": "^7.0.4",
        "lint-staged": "^11.2.6",
        "mocha": "^11.7.1",
        "nock": "^14.0.4",
        "nyc": "^17.1.0",
        "oclif": "^4.17.34",
        "rimraf": "^6.0.1",
        "semantic-release": "^25.0.3",
        "simple-git": "^3.36.0",
        "sinon": "^21.0.0",
        "string-argv": "^0.3.1",
        "tsx": "^4.20.3",
        "typescript": "npm:@typescript/typescript6@^6.0.2"
    },
    "oclif": {
        "commands": "./lib/commands",
        "dirname": "apimatic",
        "bin": "apimatic",
        "description": "The official CLI for APIMatic. \nTo get started with APIMatic's CLI using a step by step wizard, run 'apimatic quickstart'.",
        "hooks": {
            "init": "./lib/hooks/node-version",
            "command_not_found": "./lib/hooks/not-found"
        },
        "plugins": [
            "@oclif/plugin-autocomplete",
            "@oclif/plugin-help"
        ],
        "topics": {
            "api": {
                "description": "Transform & Validate your API specifications."
            },
            "auth": {
                "description": "Login using your APIMatic credentials, or view your authentication status."
            },
            "plugin": {
                "description": "Generate context plugins that teach AI coding assistants to use your SDKs."
            },
            "portal": {
                "description": "Build and serve an API Documentation portal for your APIs."
            },
            "sdk": {
                "description": "Generate and publish SDKs for your APIs in multiple languages."
            },
            "publishing": {
                "description": "Manage SDK publishing configurations."
            },
            "publishing:profile": {
                "description": "Manage publishing profiles."
            }
        },
        "topicSeparator": " "
    },
    "lint-staged": {
        "*.js": "eslint --cache --fix",
        "*.{js,ts,tsx}": "prettier --write"
    }
}
