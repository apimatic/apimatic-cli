    "csharpPackageConfiguration": {
      "type": "object",
      "description": "How the NuGet package is set up. Written by 'apimatic sdk publish' from the publishing profile.",
      "additionalProperties": false,
      "required": ["packageId"],
      "properties": {
        "packageId": {
          "type": "string",
          "description": "The NuGet package id, which the SDK card installs."
        },
        "authors": {
          "type": ["string", "null"]
        },
        "description": {
          "type": ["string", "null"]
        },
        "title": {
          "type": ["string", "null"]
        },
        "packageTags": {
          "type": ["string", "null"]
        },
        "repositoryUrl": {
          "type": ["string", "null"]
        },
        "repositoryType": {
          "type": ["string", "null"]
        },
        "packageProjectUrl": {
          "type": ["string", "null"]
        },
        "packageIcon": {
          "type": ["string", "null"]
        },
        "packageReleaseNotes": {
          "type": ["string", "null"]
        },
        "copyright": {
          "type": ["string", "null"]
        }
      }
    },
