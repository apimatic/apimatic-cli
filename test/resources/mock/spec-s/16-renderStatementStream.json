      },
      "auth": {
        "anyOf": [
          {
            "bearerAuth": {
              "in": "header",
              "name": "Authorization",
              "value": "Bearer test-bearer-token"
            }
          },
          {
            "apiKeyHeader": {
              "in": "header",
              "name": "X-API-Key",
              "value": "test-api-key"
            }
          }
        ]
      },
      "body": {
        "json": {
          "locale": "en-GB",
          "include_memos": false
        }
      }
    },
    "response": {
      "status": 200,
      "headers": {
        "Content-Type": "text/event-stream"
      },
      "body": {
        "sse": [
          {
            "data": {
              "sequence": 0,
              "content": "Operating cash - statement 01/02/2026 to 28/02/2026\n"
            }
          },
          {
            "data": {
              "sequence": 1,
              "content": "Opening balance 1000.75 USD\n"
            }
          },
          {
            "data": {
              "sequence": 2,
              "content": "Closing balance 1250.75 USD\n",
              "finished": true
            }
          },
          {
            "data": "[DONE]"
          }
        ]
      }
    }
  },
