{
  "openapi": "3.0.3",
  "info": { "title": "Pets", "version": "1.0.0", "description": "Pets, with a brand of their own." },
  "servers": [{ "url": "https://pets.example.com" }],
  "tags": [{ "name": "pets" }],
  "paths": {
    "/pets": {
      "get": {
        "operationId": "listPets",
        "tags": ["pets"],
        "summary": "List pets",
        "responses": { "200": { "description": "The pets." } }
      },
      "post": {
        "operationId": "createPet",
        "tags": ["pets"],
        "summary": "Create a pet",
        "deprecated": true,
        "responses": { "201": { "description": "The pet, created." } }
      }
    },
    "/pets/{petId}/photo": {
      "put": {
        "operationId": "uploadPetPhoto",
        "tags": ["pets"],
        "summary": "Upload a pet's photo",
        "parameters": [{ "name": "petId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "image/*": { "schema": { "type": "string", "format": "binary" } } } },
        "responses": { "204": { "description": "The photo, stored." } }
      }
    },
    "/pets/audit": {
      "get": {
        "operationId": "auditPets",
        "tags": ["pets"],
        "summary": "Audit the pets",
        "x-internal": true,
        "responses": { "200": { "description": "The audit." } }
      }
    }
  }
}
